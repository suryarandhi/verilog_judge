  "code": "module gray_counter_3bit(\n    input clk,\n    input reset,\n    output reg [2:0] gray\n);\nreg [2:0] bin;\nreg [2:0] next_bin;\nalways @(posedge clk) begin\n    if (reset) begin\n        bin  <= 3'b000;\n        gray <= 3'b000;\n    end\n    else begin\n        next_bin = bin + 1'b1;\n        bin <= next_bin;\n        gray[2] <= next_bin[2];\n        gray[1] <= next_bin[2] ^ next_bin[1];\n        gray[0] <= next_bin[1] ^ next_bin[0];\n    end\nend\nendmodule",
