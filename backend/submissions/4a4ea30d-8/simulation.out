    %set/v v011DEBA0_0, 1, 1;
    %set/v v011DEB48_0, 1, 1;
    %delay 5000, 0;
    %vpi_call 2 13 "$display", "%b", v011DEBF8_0;
    %set/v v011DEBA0_0, 0, 1;
    %set/v v011DEB48_0, 1, 1;
    %delay 5000, 0;
    %vpi_call 2 14 "$display", "%b", v011DEBF8_0;
    %set/v v011DEBA0_0, 1, 1;
    %set/v v011DEB48_0, 0, 1;
    %delay 5000, 0;
    %vpi_call 2 15 "$display", "%b", v011DEBF8_0;
    %vpi_call 2 16 "$finish";
