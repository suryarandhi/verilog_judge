#! /c/iverilog/bin/vvp
:ivl_version "0.9.7 " "(v0_9_7)";
:vpi_time_precision - 12;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_012124F8 .scope module, "tb" "tb" 2 2;
 .timescale -9 -12;
v011DEB48_0 .var "d", 0 0;
v011DEBA0_0 .var "en", 0 0;
v011DEBF8_0 .net "q", 0 0, v011D2040_0; 1 drivers
