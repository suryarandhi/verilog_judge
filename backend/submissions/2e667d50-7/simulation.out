S_011F29D0 .scope module, "tb" "tb" 2 2;
 .timescale -9 -12;
v011BEF28_0 .var "clk", 0 0;
v011BEF80_0 .net "q", 3 0, v011B2000_0; 1 drivers
v01210BF8_0 .var "rst", 0 0;
S_011B1F20 .scope module, "dut" "johnson_counter_4bit" 2 7, 3 1, S_011F29D0;
 .timescale 0 0;
v011B1FA8_0 .net "clk", 0 0, v011BEF28_0; 1 drivers
v011B2000_0 .var "q", 3 0;
v011BEED0_0 .net "rst", 0 0, v01210BF8_0; 1 drivers
E_011B40F0 .event posedge, v011B1FA8_0;
    .scope S_011B1F20;
T_0 ;
    %wait E_011B40F0;
    %load/v 8, v011BEED0_0, 1;
    %jmp/0xz  T_0.0, 8;
    %ix/load 0, 4, 0;
    %assign/v0 v011B2000_0, 0, 0;
    %jmp T_0.1;
T_0.0 ;
    %ix/load 1, 3, 0;
    %mov 4, 0, 1;
    %jmp/1 T_0.2, 4;
    %load/x1p 12, v011B2000_0, 1;
    %jmp T_0.3;
T_0.2 ;
    %mov 12, 2, 1;
T_0.3 ;
; Save base=12 wid=1 in lookaside.
    %inv 12, 1;
    %mov 8, 12, 1;
    %load/v 9, v011B2000_0, 3; Select 3 out of 4 bits
    %ix/load 0, 4, 0;
    %assign/v0 v011B2000_0, 0, 8;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_011F29D0;
T_1 ;
    %set/v v011BEF28_0, 0, 1;
T_1.0 ;
    %delay 5000, 0;
    %load/v 8, v011BEF28_0, 1;
    %inv 8, 1;
    %set/v v011BEF28_0, 8, 1;
    %jmp T_1.0;
    %end;
    .thread T_1;
    .scope S_011F29D0;
T_2 ;
    %vpi_call 2 11 "$dumpfile", "simulation.vcd";
    %vpi_call 2 12 "$dumpvars", 1'sb0, S_011F29D0;
    %set/v v011BEF28_0, 0, 1;
    %set/v v01210BF8_0, 1, 1;
    %delay 5000, 0;
    %vpi_call 2 13 "$display", "%b", v011BEF80_0;
    %set/v v011BEF28_0, 0, 1;
    %set/v v01210BF8_0, 0, 1;
    %delay 5000, 0;
    %vpi_call 2 14 "$display", "%b", v011BEF80_0;
    %set/v v011BEF28_0, 0, 1;
    %set/v v01210BF8_0, 0, 1;
    %delay 5000, 0;
    %vpi_call 2 15 "$display", "%b", v011BEF80_0;
    %set/v v011BEF28_0, 0, 1;
    %set/v v01210BF8_0, 0, 1;
    %delay 5000, 0;
    %vpi_call 2 16 "$display", "%b", v011BEF80_0;
    %vpi_call 2 17 "$finish";
    %end;
    .thread T_2;
