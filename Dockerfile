FROM python:3.11-slim RUN apt-get update && apt-get install -y --no-install-recommends iverilog && rm -rf /var/lib/apt/lists/* WORKDIR /app COPY backend/requirements.txt backend/requirements.txt RUN pip install --no-cache-dir -r backend/requirements.txt gunicorn COPY backend/ backend/ COPY frontend/ frontend/ ENV PORT=5000 EXPOSE 5000 WORKDIR /app/backend CMD gunicorn --bind 0.0.0.0:$PORT --workers 2 --timeout 30 app:app